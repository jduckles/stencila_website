#!/usr/bin/env python3
import sys
import yaml
import requests
from pathlib import Path

def extract_yaml_header(content):
    if content.startswith('---\n'):
        parts = content.split('---\n', 2)
        if len(parts) >= 3:
            try:
                return yaml.safe_load(parts[1]), parts[2]
            except yaml.YAMLError:
                return None, content
    return None, content

def merge_yaml(yaml1, yaml2):
    merged = yaml1.copy()
    for key, value in yaml2.items():
        if key not in merged:
            merged[key] = value
        elif isinstance(merged[key], dict) and isinstance(value, dict):
            merged[key] = merge_yaml(merged[key], value)
    return merged

def process_yaml_file(input_file):
    # Read the input YAML file
    with open(input_file, 'r') as file:
        yaml_data = yaml.safe_load(file)

    # Download the markdown content from the URL
    url = yaml_data.get('source')
    if not url:
        print("Error: 'source' URL not found in the YAML file.")
        return

    response = requests.get(url)
    if response.status_code != 200:
        print(f"Error: Failed to download content from {url}")
        return

    markdown_content = response.text

    # Extract YAML header from markdown content if it exists
    content_yaml, markdown_body = extract_yaml_header(markdown_content)

    # Merge YAML data
    if content_yaml:
        merged_yaml = merge_yaml(yaml_data, content_yaml)
    else:
        merged_yaml = yaml_data

    # Prepare the output content
    output_content = "---\n"
    output_content += yaml.dump(merged_yaml, default_flow_style=False)
    output_content += "---\n\n"
    output_content += markdown_body

    # Generate the output filename
    input_path = Path(input_file)
    output_file = input_path.with_suffix('.smd')

    # Write the output content to the file
    with open(output_file, 'w', encoding='utf-8') as file:
        file.write(output_content)

    print(f"Successfully created {output_file}")

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python script.py <input_yaml_file>")
    else:
        input_file = sys.argv[1]
        process_yaml_file(input_file)
